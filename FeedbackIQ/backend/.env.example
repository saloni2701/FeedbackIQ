DATABASE_URL=postgresql+psycopg2://feedbackiq:feedbackiq@localhost:5432/feedbackiq
CORS_ORIGINS=http://localhost:5173

# Login: generate a long random value, e.g.  python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me
ACCESS_TOKEN_MINUTES=1440

# Sentiment: "vader" (fast, offline after first NLTK download) or "transformers" (more accurate)
SENTIMENT_BACKEND=vader
SENTIMENT_MODEL=cardiffnlp/twitter-roberta-base-sentiment-latest

# Embeddings used to group similar comments: "tfidf" (light) or "sentence-transformers"
EMBEDDING_BACKEND=tfidf
EMBEDDING_MODEL=all-MiniLM-L6-v2

CLUSTER_DISTANCE_THRESHOLD=0.6
MIN_BERTOPIC_DOCS=50
